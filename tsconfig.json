{
  "extends": [
    // https://github.com/tsconfig/bases
    "@tsconfig/recommended",
    "@tsconfig/strictest",
    "@tsconfig/node-lts"
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext"],
    "declaration": true,
    "declarationMap": true,
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": false,
    "checkJs": false
  },
  "exclude": ["node_modules", "test", "dist"]
}

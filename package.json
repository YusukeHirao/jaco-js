{
  "name": "jaco",
  "version": "4.0.0",
  "description": "Japanese Character Optimizer.",
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint --fix --quiet **/*.ts",
    "docs": "typedoc --mode modules --out docs jaco.ts",
    "test": "vitest run",
    "coveralls": "yarn test && cat ./coverage/lcov.info | coveralls"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:jaco-project/jaco-js.git"
  },
  "keywords": [
    "japanese",
    "javascript",
    "string",
    "character",
    "katakana",
    "hiragana",
    "unicode",
    "surrogate pair"
  ],
  "author": "YusukeHirao",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jaco-project/jaco-js/issues"
  },
  "homepage": "http://jaco-project.github.io/docs/",
  "dependencies": {
    "commander": "^9.0.0"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "20.1.3",
    "@tsconfig/recommended": "1.0.6",
    "@tsconfig/strictest": "2.0.5",
    "@typescript-eslint/eslint-plugin": "7.13.0",
    "coveralls": "3.1.1",
    "eslint": "9.4.0",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-jsdoc": "48.2.9",
    "eslint-plugin-node": "11.1.0",
    "prettier": "3.3.2",
    "typedoc": "0.25.13",
    "typescript": "5.4.5",
    "vitest": "1.6.0"
  },
  "volta": {
    "node": "22.2.0",
    "yarn": "1.22.22"
  }
}

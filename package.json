{
  "name": "jaco",
  "version": "4.0.0",
  "description": "Japanese Character Optimizer.",
  "main": "./index.js",
  "module": "./index.js",
  "types": "./index.d.ts",
  "scripts": {
    "build": "yarn build:esm; yarn build:cli",
    "build:esm": "tsc",
    "clean": "yarn clean:esm",
    "clean:esm": "tsc --build --clean",
    "lint": "eslint --fix --quiet **/*.ts",
    "docs": "typedoc --mode modules --out docs jaco.ts",
    "test": "jest ./test/* --coverage",
    "coveralls": "yarn test && cat ./coverage/lcov.info | coveralls",
    "prepare": "yarn clean; yarn build"
  },
  "jest": {
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js"
    ],
    "transform": {
      "^.+\\.(ts|tsx)$": "ts-jest"
    },
    "globals": {
      "ts-jest": {
        "tsConfig": "./test/tsconfig.json"
      }
    },
    "testMatch": [
      "**/*.spec.(ts|tsx)"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:jaco-project/jaco-js.git"
  },
  "keywords": [
    "japanese",
    "javascript",
    "string",
    "character",
    "katakana",
    "hiragana",
    "unicode",
    "surrogate pair"
  ],
  "author": "YusukeHirao",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jaco-project/jaco-js/issues"
  },
  "homepage": "http://jaco-project.github.io/docs/",
  "dependencies": {
    "commander": "^9.0.0"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "20.1.3",
    "@tsconfig/recommended": "1.0.6",
    "@tsconfig/strictest": "2.0.5",
    "@types/jest": "29.5.12",
    "@typescript-eslint/eslint-plugin": "7.13.0",
    "coveralls": "3.1.1",
    "eslint": "9.4.0",
    "eslint-plugin-eslint-comments": "3.2.0",
    "eslint-plugin-jest": "28.6.0",
    "eslint-plugin-jsdoc": "48.2.9",
    "eslint-plugin-node": "11.1.0",
    "jest": "29.7.0",
    "prettier": "3.3.2",
    "ts-jest": "29.1.4",
    "typedoc": "0.25.13",
    "typescript": "5.4.5"
  },
  "volta": {
    "node": "22.2.0",
    "yarn": "1.22.22"
  }
}

{
  "name": "jaco",
  "version": "4.0.0",
  "description": "Japanese Character Optimizer.",
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./fn/naturalKanaOrder": {
      "import": "./fn/naturalKanaOrder.js",
      "types": "./fn/naturalKanaOrder.d.ts"
    },
    "./fn/naturalKanaSort": {
      "import": "./fn/naturalKanaSort.js",
      "types": "./fn/naturalKanaSort.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint --fix && prettier --write \"**/*.{ts,json,md,*rc}\"",
    "docs": "typedoc --out docs jaco.ts",
    "test": "vitest run",
    "coveralls": "yarn test && cat ./coverage/lcov.info | coveralls"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YusukeHirao/jaco-js.git"
  },
  "keywords": [
    "japanese",
    "javascript",
    "string",
    "character",
    "katakana",
    "hiragana",
    "unicode",
    "surrogate pair"
  ],
  "author": "YusukeHirao",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/YusukeHirao/jaco-js/issues"
  },
  "dependencies": {
    "commander": "^9.0.0"
  },
  "devDependencies": {
    "@tsconfig/node-lts": "22.0.1",
    "@tsconfig/recommended": "1.0.8",
    "@tsconfig/strictest": "2.0.5",
    "typescript-eslint": "8.30.1",
    "coveralls": "3.1.1",
    "eslint": "9.24.0",
    "prettier": "3.5.3",
    "typedoc": "0.28.2",
    "typescript": "5.8.3",
    "vitest": "3.1.1"
  },
  "volta": {
    "node": "22.2.0",
    "yarn": "1.22.22"
  }
}
